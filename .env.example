# =====================================================================
# Painel Comafe — variáveis de ambiente
# Preencha os campos marcados com PREENCHER com as credenciais da VPS.
# Este arquivo NÃO vai para o git (.gitignore: .env*).
# =====================================================================

# --- PostgreSQL (PREENCHER) -------------------------------------------
# Formato: postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public
DATABASE_URL=""

# --- Redis (PREENCHER — opcional) --------------------------------------
# Usado para avisar os painéis abertos em tempo real quando o Kommo muda.
# Sem Redis funciona igual em um único servidor.
# Formato: redis://:SENHA@HOST:6379/0
REDIS_URL=""

# --- Better Auth -------------------------------------------------------
# Segredo gerado automaticamente. Não compartilhe.
BETTER_AUTH_SECRET=""
# Endereço público do painel (na VPS: https://comafe.matratecnologia.com)
BETTER_AUTH_URL="http://localhost:3000"

# --- Kommo -------------------------------------------------------------
KOMMO_BASE_URL="https://comafeoficial.kommo.com"
# Token longo da integração (copiado do .env da pasta comafe). Vence em 26/11/2026.
KOMMO_TOKEN=""
KOMMO_PIPELINE_ID="14542159"

# --- Sincronização -----------------------------------------------------
# Data a partir da qual os leads entram no painel (AAAA-MM-DD)
SYNC_DESDE="2026-10-01"
# Segredo para o webhook do Kommo e para chamar /api/sync por agendador (cron)
SYNC_SECRET=""
# Sincroniza sozinho a cada N minutos enquanto o servidor estiver rodando (0 = desliga)
SYNC_INTERVALO_MIN="10"

# --- Primeiro acesso (usado só pelo script npm run criar-admin) --------
ADMIN_NOME="Administrador"
ADMIN_EMAIL=""
ADMIN_SENHA=""

# --- Meta (PREENCHER) — usuário do sistema de cada anunciante, permissão ads_read ---
# A conta de anúncios lida com cada token define o dono dos anúncios.
META_TOKEN_ALEX=""
META_TOKEN_MARCOS=""
META_TOKEN_MATRA=""
# Opcional: limitar as contas lidas com cada token (separe por vírgula). Ex.: "act_908957968151464"
META_CONTAS_ALEX=""
META_CONTAS_MARCOS=""
META_CONTAS_MATRA=""
META_GRAPH_VERSION="v24.0"
# Atualiza o catálogo do Meta a cada N minutos (0 = desliga) e quantos dias de investimento ler
META_INTERVALO_MIN="60"
META_DIAS_GASTO="90"

# --- App do Facebook para o botão "Conectar com Facebook" (PREENCHER uma vez) ---
# developers.facebook.com › Meus apps › Painel Comafe › Configurações do app › Básico
META_APP_ID=""
META_APP_SECRET=""
# Só se o app for do tipo "Empresa" (Login do Facebook para Empresas): ID da configuração com ads_read
META_LOGIN_CONFIG_ID=""
